       "      <td>0.000409</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>2026-09-11</th>\n",
       "      <td>0.000480</td>\n",
       "      <td>0.000459</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>2026-09-14</th>\n",
       "      <td>0.000451</td>\n",
       "      <td>0.000445</td>\n",
       "    </tr>\n",
       "  </tbody>\n",
       "</table>\n",
       "</div>"
      ],
      "text/plain": [
       "            ewma_0.94  ewma_0.97\n",
       "Date                            \n",
       "2026-09-08   0.000385   0.000414\n",
       "2026-09-09   0.000401   0.000421\n",
       "2026-09-10   0.000378   0.000409\n",
       "2026-09-11   0.000480   0.000459\n",
       "2026-09-14   0.000451   0.000445"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "lambdas = [0.94, 0.97]\n",
    "\n",
    "sigma2 = pd.DataFrame(index=r.index)\n",
    "for lam in lambdas:\n",
    "    sigma2[f'ewma_{lam}'] = r2.shift(1).ewm(alpha=(1 - lam), adjust=False).mean()\n",
    "\n",
    "sigma2.tail()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f96dbe58",
   "metadata": {},
   "source": [
    "## RMSE: ¿cuál λ pronostica mejor?\n",
    "\n",
    "Mismo criterio que en media móvil: comparamos cada pronóstico $\\sigma^2_t$\n",
    "contra el $R^2_t$ real de ese día. **El $\\lambda$ con menor RMSE es el que\n",
    "mejor pronostica** — es la respuesta lista para \"¿por qué ese lambda?\" en\n",
    "la presentación oral."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "b3a52472",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "ewma_0.94    0.001421\n",
       "ewma_0.97    0.001414\n",
       "dtype: float64"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "sigma2_rmse = sigma2.dropna()\n",
    "r2_rmse = r2.loc[sigma2_rmse.index]\n",
    "\n",
    "rmse = pd.Series(dtype=float)\n",
    "for lam in lambdas:\n",
    "    rmse[f'ewma_{lam}'] = np.sqrt((1/len(r2_rmse)) * ((r2_rmse - sigma2_rmse[f'ewma_{lam}'])**2).sum())\n",
    "\n",
    "rmse"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2cf723bd",
   "metadata": {},
   "source": [
    "## Lambda óptimo ($\\lambda^*$)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "444c1a20",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Lambda optimo (menor RMSE): lambda* = 0.97\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "ewma_0.94    0.001421\n",
       "ewma_0.97    0.001414\n",
       "dtype: float64"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "lambda_opt = float(rmse.idxmin().replace('ewma_', ''))\n",
    "print(f\"Lambda optimo (menor RMSE): lambda* = {lambda_opt}\")\n",
    "rmse"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7caad814",
   "metadata": {},
   "source": [
    "## Pronóstico de volatilidad para mañana\n",
    "\n",
    "Con $\\lambda^*$, aplicamos la fórmula recursiva una vez más usando el\n",
    "$\\sigma^2$ de hoy y el $R^2$ de hoy, para obtener el pronóstico de mañana:\n",
    "\n",
    "$$\\sigma^2_{T+1} = (1-\\lambda^*)\\,R^2_T + \\lambda^*\\,\\sigma^2_T$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "8fb08230",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Varianza pronosticada para manana (lambda*=0.97): 0.000444\n",
      "Volatilidad anualizada pronosticada: 33.45%\n"
     ]
    }
   ],
   "source": [
    "sigma2_hoy = sigma2[f'ewma_{lambda_opt}'].iloc[-1]\n",
    "r2_hoy = r2.iloc[-1]\n",
    "\n",
    "var_manana = lambda_opt * sigma2_hoy + (1 - lambda_opt) * r2_hoy\n",
    "vol_anual_manana = np.sqrt(252 * var_manana)\n",
    "\n",
    "print(f\"Varianza pronosticada para manana (lambda*={lambda_opt}): {var_manana:.6f}\")\n",
    "print(f\"Volatilidad anualizada pronosticada: {vol_anual_manana:.2%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6db27b86",
   "metadata": {},
   "source": [
    "## Verificación contra la volatilidad histórica simple\n",
    "\n",
    "Como chequeo de sanidad (igual que la celda \"σ hist excel\" de la hoja de\n",
    "cálculo de clase), comparamos contra la desviación estándar simple de\n",
    "todos los retornos del período — sin pesos, todos los días cuentan igual.\n",
    "Si el número de EWMA está en un rango parecido, nos da confianza de que el\n",
    "cálculo está bien."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "4babf969",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Volatilidad historica simple (toda la muestra, anualizada): 35.46%\n",
      "Volatilidad EWMA pronosticada (lambda*=0.97): 33.45%\n"
     ]
    }
   ],
   "source": [
    "vol_hist_diaria = r.std()\n",
    "vol_hist_anual = vol_hist_diaria * np.sqrt(252)\n",
    "\n",
    "print(f\"Volatilidad historica simple (toda la muestra, anualizada): {vol_hist_anual:.2%}\")\n",
    "print(f\"Volatilidad EWMA pronosticada (lambda*={lambda_opt}): {vol_anual_manana:.2%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ab78c1c0",
   "metadata": {},
   "source": [
    "## Gráfica: volatilidad EWMA anualizada por λ\n",
    "\n",
    "Visualizamos ambos valores de $\\lambda$ en el tiempo — $\\lambda=0.94$\n",
    "reacciona un poco más rápido a los cambios recientes; $\\lambda=0.97$ es\n",
    "ligeramente más suave/estable (le da más memoria al pasado)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "2558ef73",
   "metadata": {},
   "outputs": [
